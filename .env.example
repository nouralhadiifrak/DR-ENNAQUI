# Copy to .env.local (never commit it). On Vercel: Project → Settings → Environment Variables.

# Public URL of the site (used for SEO metadata, hreflang and JSON-LD)
NEXT_PUBLIC_SITE_URL=https://example.com

# Google Calendar booking (see README → "Google Calendar setup")
GOOGLE_SERVICE_ACCOUNT_EMAIL=booking@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The calendar that receives appointments. For a personal Google account
# this is the Gmail address of the calendar owner.
GOOGLE_CALENDAR_ID=you@gmail.com
